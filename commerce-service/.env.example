PORT=8788
RWA_COMMERCE_HOST=0.0.0.0
RWA_COMMERCE_DB=/var/lib/rwa-commerce/commerce.sqlite
RWA_COMMERCE_PUBLIC_ORIGIN=https://narzulalistiqlal.github.io
RWA_COMMERCE_ALLOWED_ORIGINS=https://narzulalistiqlal.github.io
RWA_COMMERCE_FRONTEND_URL=https://narzulalistiqlal.github.io/rwa
RWA_COMMERCE_QUOTE_TTL_MS=600000
RWA_COMMERCE_PAYMENT_TTL_MS=1800000
RWA_COMMERCE_TAX_BPS=0
# Required only if shipping is enabled. Omit to fail-closed on shipping quotes.
# RWA_COMMERCE_SHIPPING_FLAT_CENTS=1500000
# Store only the SHA-256 hex digest of the admin bearer token.
RWA_COMMERCE_ADMIN_TOKEN_SHA256=REPLACE_WITH_SHA256_HEX
MIDTRANS_SERVER_KEY=REPLACE_WITH_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=REPLACE_WITH_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
