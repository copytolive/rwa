[Unit]
Description=GOLD24 continuous weekly-profit rules-locked backtest worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gold24
Group=gold24
WorkingDirectory=/opt/rwa
EnvironmentFile=/etc/gold24.env
ExecStart=/opt/gold24-venv/bin/python /opt/rwa/backtest/gold24/weekly_profit_runner.py
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gold24 /opt/rwa

[Install]
WantedBy=multi-user.target
