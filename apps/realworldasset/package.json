{
  "name": "realworldasset",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-rwa-paths.mjs && node scripts/postbuild-live-runtime.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:public-auth": "node scripts/verify-public-auth.mjs",
    "verify:overlays": "node scripts/verify-overlays.mjs",
    "verify:chat01": "node scripts/verify-overlays.mjs && node scripts/verify-public-auth.mjs",
    "verify:chat03": "node scripts/verify-chat03-details.mjs && node scripts/verify-interaction-contract.mjs && node scripts/verify-all-interactions.mjs",
    "verify:chat04": "npm run verify:live-compat",
    "verify:chat05": "npm run verify:live-compat",
    "verify:chat06": "npm run verify:live-compat",
    "verify:chat07": "npm run verify:live-compat",
    "verify:chat08": "npm run verify:live-compat",
    "verify:chat09": "npm run verify:live-compat",
    "verify:chat10": "npm run verify:live-compat",
    "verify:chat11": "npm run verify:live-compat",
    "verify:chat12": "npm run verify:live-compat",
    "verify:chat13": "npm run verify:live-compat",
    "verify:legacy:chat04": "node scripts/verify-chat04-trading.mjs",
    "verify:legacy:chat05": "node scripts/verify-chat05-account.mjs",
    "verify:legacy:chat06": "node scripts/verify-chat06-account-tools.mjs",
    "verify:legacy:chat07": "node scripts/verify-chat07-compliance.mjs",
    "verify:legacy:chat08": "node scripts/verify-chat08-rewards.mjs",
    "verify:legacy:chat09": "node scripts/verify-chat09-commerce.mjs",
    "verify:legacy:chat10": "node scripts/verify-chat10-community.mjs",
    "verify:legacy:chat11": "node scripts/verify-chat11-settings-support.mjs",
    "verify:legacy:chat12": "node scripts/verify-chat12-merchant-core.mjs",
    "verify:legacy:chat13": "node scripts/verify-chat13-merchant-growth.mjs",
    "verify:program-workspaces": "node scripts/verify-program-workspaces.mjs",
    "verify:live-only": "node scripts/verify-live-only.mjs",
    "verify:live-compat": "node scripts/verify-live-only.mjs && node scripts/verify-interaction-contract.mjs && node scripts/verify-all-interactions.mjs && node scripts/verify-live-runtime.mjs && node scripts/verify-program-workspaces.mjs",
    "verify:interactions": "node scripts/verify-live-only.mjs && node scripts/verify-interaction-contract.mjs && node scripts/verify-all-interactions.mjs && node scripts/verify-live-runtime.mjs && node scripts/verify-program-workspaces.mjs",
    "verify:live-runtime": "node scripts/verify-live-runtime.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
