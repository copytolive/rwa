{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {"@/*": ["./src/*"]},
    "typeRoots": ["./types/verify"]
  },
  "include": ["src/components/**/*.tsx", "src/components/**/*.ts", "src/app/**/*.tsx", "src/lib/**/*.ts"]
}
