RWA_BUSINESS_PORT=8790
RWA_BUSINESS_HOST=0.0.0.0
RWA_BUSINESS_DB=/var/lib/rwa-business/business.sqlite
RWA_COMMERCE_DB=/var/lib/rwa-commerce/commerce.sqlite
RWA_BUSINESS_ALLOWED_ORIGINS=https://copytolive.github.io,https://seablueprint.com
# sha256 of a strong admin bearer token; never commit the token itself.
RWA_BUSINESS_ADMIN_TOKEN_SHA256=
# JSON map of terminal id -> HMAC secret. Inject through secret manager only.
RWA_BUSINESS_TERMINAL_SECRETS={}
RWA_BUSINESS_RECONCILE_MS=300000
RWA_BUSINESS_PUBLIC_URL=https://seablueprint.com/rwa-business
