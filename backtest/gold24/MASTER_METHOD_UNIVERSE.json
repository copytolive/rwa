      "note": "Candidate PASS is not final validation.",
      "min_entry": 300,
      "min_pf_net": 1.2,
      "max_dd_pct": 25,
      "min_ev_per_trade_usd_exclusive": 0,
      "min_oos_pf": 1,
      "monte_carlo_pass_required": true,
      "monte_carlo_probability_positive_min_pct": 95,
      "positive_year_min_pct": 60,
      "max_corr": 0.5,
      "classification": {
        "HARD_PASS": "Candidate PASS + 8/8 hard gates",
        "WATCH": "Candidate PASS + at least 5/8 hard gates",
        "FAIL": "otherwise"
      }
    },
    "script_validation": {
      "python": "real .py file + CANDIDATE + EXPECTED + config_hash + exact canonical qty parity PASS",
      "mt5": "real .mq5 file + identical config/hash + real engine/include + native MetaEditor compile PASS + native MT5 Strategy Tester PASS",
      "failure_rule": "If either side fails, do not label the method VERIFIED."
    }
  },
  "diversification_policy": {
