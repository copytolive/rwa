{
  "schema": "gold24-master-method-universe-v1",
  "purpose": "Single authoritative method universe and diversification policy for GOLD24 discovery, validation, and portfolio construction.",
  "gold_execution_rules": {
    "symbol": "GOLD",
    "allowed_timeframes": [
      "H1",
      "H4",
      "D1"
    ],
    "canonical_current_timeframe": "D1",
    "pending_order_only": true,
    "allowed_entry_methods": [
      "STOP",
      "LIMIT"
    ],
    "direction_modes": [
      "LONG_ONLY",
      "SHORT_ONLY",
      "BOTH"
    ],
    "fixed_sl_price_usd": {
      "min": 5,
      "max": 25,
      "step": 0.5
    },
    "fixed_tp_price_usd": {
      "min": 5,
      "max": 25,
      "step": 0.5
    },
    "gold_pip_size_usd": 0.01,
    "sl_pips_range": {
      "min": 500,
      "max": 2500
    },
    "tp_pips_range": {
      "min": 500,
      "max": 2500
    },
    "flat_lot_backtest": true,
    "compounding_backtest": false,
    "cost_floor_round_trip": 0.0032
  },
  "selection_contract": {
    "candidate_pass": {
      "min_entry": 100,
      "min_net_profit_usd": 20000,
      "max_abs_pearson_log_return_equity_corr": 0.5,
      "corr_selection": "per-symbol greedy; when >0.50 remove lower-quality/ranking method"
    },
    "validated": {
      "note": "Separate from Candidate PASS. Full BACKTEST_RULES quality/robustness gates must be satisfied before VALIDATED."
    }
  },
  "diversification_policy": {
    "discovery": "balanced across every implemented engine family; exploit seeds only inside the target family",
    "portfolio_ready_min_distinct_families": 6,
    "portfolio_ready_max_single_family_share": 0.25,
    "library_may_exceed_family_cap": true,
    "rationale": "Do not discard useful research rows; prevent a concentrated library from being mislabeled portfolio-ready."
  },
