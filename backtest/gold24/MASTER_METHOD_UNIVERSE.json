      "max_abs_pearson_log_return_equity_corr": 0.5,
      "corr_scope": "GLOBAL per-symbol across the complete selected set",
      "corr_selection": "quality-ordered greedy; when abs Pearson(log-return equity) >0.50 remove the lower-quality/ranking method"
