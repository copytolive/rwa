# Copy to a host-side .env file. Never commit the real values.
RWA_KEY_ENCRYPTION_SECRET=replace-with-32-plus-random-characters
RWA_PUBLIC_ORIGIN=https://worker.example.com
RWA_ALLOWED_ORIGINS=https://narzulalistiqlal.github.io
RWA_CONTROL_URL=https://narzulalistiqlal.github.io/rwa/agent-worker/control.json
RWA_LOOP_MS=3000
RWA_RISK_JSON={"dailyLoss":250,"maxLeverage":5,"maxExposure":5000,"perAsset":2000,"kill":false}

# Leave EMPTY for all TESTNET/beta stages.
# Only set on the production host after every Launch Gate passes and repository mainnet_enabled=true.
RWA_MAINNET_APPROVED=
